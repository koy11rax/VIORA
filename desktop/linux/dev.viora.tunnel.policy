<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Viora</vendor>
  <action id="dev.viora.tunnel">
    <description>Start the VIORA VPN tunnel</description>
    <description xml:lang="ru">Подключить VPN VIORA</description>
    <message>Authentication is required to manage the VIORA VPN tunnel</message>
    <message xml:lang="ru">Для подключения VPN VIORA требуется разрешение администратора</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/viora/viora_tunnel</annotate>
  </action>
</policyconfig>
